rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profil + toutes les sous-collections de l'utilisateur
    // (conversations, courses, documents, quizzes...) :
    // chaque utilisateur n'accède qu'à SES propres données.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Progression / statistiques (doc par utilisateur, collection racine).
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tout le reste est refusé par défaut.
  }
}
